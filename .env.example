# ---------------------------------------------------------------------------
# SGE - Sistema de Gestao Escolar
# Modelo de variaveis de ambiente.
#
# Copie este arquivo para `.env` e ajuste os valores.
# O arquivo `.env` NUNCA deve ser versionado (ja consta no .gitignore).
# ---------------------------------------------------------------------------

# --- Ambiente ---------------------------------------------------------------
# development | testing | production
APP_ENV=development

# --- Seguranca --------------------------------------------------------------
# Gere uma chave forte antes de publicar em producao:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A aplicacao SE RECUSA a iniciar em producao com a chave padrao.
SECRET_KEY=troque-esta-chave-antes-de-publicar

# --- Banco de dados ---------------------------------------------------------
# Desenvolvimento: deixe em branco para usar o SQLite em instance/sge.db
# Producao (PostgreSQL):
#   DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sge
DATABASE_URL=

# Pool de conexoes (apenas producao)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Sessao e autenticacao --------------------------------------------------
# Minutos de inatividade ate a sessao expirar
SESSAO_MINUTOS=120

# Tentativas de login antes do bloqueio temporario
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Validade do link de recuperacao de senha (segundos)
TOKEN_RECUPERACAO_VALIDADE=1800

# --- Politica de senha ------------------------------------------------------
SENHA_TAMANHO_MINIMO=8
SENHA_EXIGE_MAIUSCULA=true
SENHA_EXIGE_MINUSCULA=true
SENHA_EXIGE_NUMERO=true
SENHA_EXIGE_SIMBOLO=false

# --- Limites de requisicao --------------------------------------------------
# Em producao com varios processos, use Redis para que o limite seja
# compartilhado:  RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=10 per minute
RATELIMIT_RECUPERACAO=5 per hour

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=8

# --- Listagens --------------------------------------------------------------
ITENS_POR_PAGINA=20

# --- Backup -----------------------------------------------------------------
BACKUP_RETENCAO_DIAS=30
BACKUP_MAXIMO_ARQUIVOS=60

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_NIVEL=INFO

# Exibe o SQL gerado no console (apenas para depuracao)
SQLALCHEMY_ECHO=false

# --- Servidor de desenvolvimento --------------------------------------------
HOST=0.0.0.0
PORTA=5000
