# ---------------------------------------------------------------------------
# SGE - Sistema de Gestao Escolar
# Arquivos e diretorios ignorados pelo controle de versao
# ---------------------------------------------------------------------------

# Ambiente virtual
venv/
.venv/
env/
ENV/

# Bytecode Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribuicao / empacotamento
build/
dist/
*.egg-info/
.eggs/

# Variaveis de ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key

# Banco de dados local (SQLite) e pasta instance
instance/
*.db
*.sqlite
*.sqlite3

# Uploads enviados por usuarios.
# Ficam FORA de app/static/: sao dados pessoais (foto de aluno) e so podem
# sair por rota autenticada.
uploads/


# Backups gerados pelo sistema
backups/*
!backups/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Testes e cobertura
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Ferramentas de qualidade
.ruff_cache/
.mypy_cache/

# Claude Code
# `.claude/settings.json`, `agents/`, `commands/` e `hooks/` SAO versionados:
# sao a configuracao de trabalho da equipe. Ficam de fora apenas os arquivos
# especificos de uma maquina.
.claude/settings.local.json
.claude/launch.json

# IDEs / editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
